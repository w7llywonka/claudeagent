# Store real credentials only in Railway variables or your local environment.
# Never paste credentials into Discord or commit an edited .env file.
DISCORD_TOKEN=
ANTHROPIC_API_KEY=

# Comma-separated numeric channel IDs. Required unless ENABLE_DMS=true.
# An empty list never permits ordinary server-channel messages.
# Explicit /ask commands work outside this allowlist without enabling passive collection.
ALLOWED_CHANNEL_IDS=
# Optional subset of allowed channels: reply to each human message here.
AUTO_REPLY_CHANNEL_IDS=
# Controls ordinary DMs; explicit /ask commands work independently.
ENABLE_DMS=false
# Optional comma-separated numeric Discord user IDs, used by !budget.
OWNER_IDS=

# Local Python default. For Railway and Docker, set /data/chat.db.
DB_PATH=data/chat.db

# USD allowance across ALL users. Total is cumulative for this database.
DAILY_BUDGET_USD=0.50
MONTHLY_BUDGET_USD=5
TOTAL_BUDGET_USD=5

# Default short reply; code enforces an absolute 20000-token ceiling.
MAX_OUTPUT_TOKENS=120
MAX_REPLY_WORDS=45
MAX_REPLY_CHARS=300
# Current message text sent to Claude; archive storage has its own 4000-char cap.
MAX_INPUT_CHARS=800
CONTEXT_MESSAGES=6
MAX_CONCURRENT_REQUESTS=2
MAX_REQUESTS_PER_MINUTE=20
# Global per-user chat cooldown in seconds; 0 disables it. Range 0..86400.
COOLDOWN_SECONDS=15

# Archive every new eligible human text message in allowed channels and update
# local style from ordinary messages, even without a mention or during limits.
# !forget/!optout are never retained; commands/override attempts do not teach style.
# No AI request per observed message. False keeps triggered conversations only.
# User-installed /ask saves explicit questions only; external memory is per person/channel.
PASSIVE_LEARNING=true
# Archive retention: oldest messages are pruned when any limit is reached.
# Age cleanup runs on startup and roughly hourly. Range: 1..365 days.
MESSAGE_RETENTION_DAYS=30
# Total archived message count across all channels. Range: 100..1000000.
MESSAGE_MAX_ROWS=50000
# Total stored message text in MiB (UTF-8 bytes), excluding SQLite overhead.
# Range: 1..128. A 256 MB volume gives headroom with the defaults.
MESSAGE_MAX_MB=64
# Keep false for the short policy. Prompts below 512 tokens cannot cache.
CACHE_SYSTEM_PROMPT=false

# Model and behavior are fixed in code:
# claude-haiku-5-5 / output_config.effort=low / thinking.type=disabled
# Cooldown is configured above; shared rate, concurrency and budget limits still apply.
